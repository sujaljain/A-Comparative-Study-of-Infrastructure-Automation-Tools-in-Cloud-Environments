# =============================================================================
# terraform.tfvars.example
# Copy this to terraform.tfvars and fill in your values before running
# DO NOT commit terraform.tfvars to Git (it contains sensitive values)
# =============================================================================

aws_region        = "ap-south-1"
project_name      = "cloud-automation-study"
environment       = "research"
instance_type     = "t3.medium"
node_count        = 10            # Options: 5, 10, 25, 50
key_pair_name     = "your-key-pair-name"
private_key_path  = "~/.ssh/your-key.pem"
control_node_cidr = "10.0.0.0/8"
